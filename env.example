# QuickRAG Configuration
# Copy this file to .env and fill in your values

# OpenAI API Key (required for cloud/hybrid mode)
OPENAI_API_KEY=sk-your-key-here

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Ollama Configuration (for local LLM)
OLLAMA_HOST=http://localhost:11434

# Pipeline Mode: local, cloud, or hybrid
QUICKRAG_MODE=hybrid

# Default Collection Name
QUICKRAG_COLLECTION=documents

# Retrieval Settings
RETRIEVAL_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50

